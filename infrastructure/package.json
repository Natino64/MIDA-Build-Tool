{
  "name": "@rafferty-softworks/mida-build-tool-infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for MIDA Build Tool.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "synth": "npm run build && cdk synth",
    "diff": "npm run build && cdk diff",
    "deploy": "npm run build && cdk deploy --require-approval broadening"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
